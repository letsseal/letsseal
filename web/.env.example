# Copy to web/.env and fill in. Everything the web tier reads is listed here.
# The app audits this at boot (see instrumentation.ts): in production it refuses
# to start if a fatal item is missing, and warns on the rest.

# Postgres (dev + prod). Local dev via Homebrew: `brew install postgresql@17`,
# `brew services start postgresql@17`, `createdb letsseal`.
DATABASE_URL="postgresql://USER@localhost:5432/letsseal?schema=public"

# How many PostgreSQL connections this process may hold. Optional: the default is
# roughly two per core plus one (capped at 20), which stays well under a stock
# max_connections of 100 for a couple of instances. Raise it on a bigger box.
# When the pool is exhausted, transactions fail to acquire a connection and
# throw, and the clearest symptom is a signing request failing on its audit write.
# DATABASE_POOL_MAX="17"
SIGNING_SERVICE_URL="http://127.0.0.1:8081"
APP_URL="http://localhost:3000"
CA_DIR="../ca/out"

# REQUIRED. Signs sessions, the identity-seal flow cookie, and (unless
# AUDIT_HMAC_SECRET is set) the audit chain. Generate: `openssl rand -base64 32`.
AUTH_SECRET=""

# REQUIRED. Shared bearer the signing service demands on every call. Must equal
# LETSSEAL_SERVICE_TOKEN in signing-service/.env. Generate: `openssl rand -hex 32`.
LETSSEAL_SERVICE_TOKEN=""

# Dedicated key for the tamper-evident audit chain. Recommended: without it the
# chain falls back to AUTH_SECRET, so rotating sessions would invalidate every
# historical audit trail. Generate: `openssl rand -hex 32`.
AUDIT_HMAC_SECRET=""

# Bearer required by POST /api/anchors/upgrade, the cron that advances pending
# Bitcoin anchors and anchors the transparency log root. Unset means anchors stay
# "pending" forever. Generate: `openssl rand -hex 32`.
#   */30 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#                   http://localhost:3000/api/anchors/upgrade
CRON_SECRET=""

# --- Which forwarding header identifies the client (see web/lib/ip.ts) ---
# Set this to match YOUR reverse proxy. Every per-IP control depends on it: the
# sign-in throttle, the access-code lockout, the report/verify/signup caps, and
# the signer IP recorded in the audit trail.
#
#   cloudflare  read CF-Connecting-IP  (Cloudflare tunnel or proxy in front)
#   xrealip     read X-Real-IP         (deploy/nginx-letsseal.conf sets this)
#   xff         read the LAST X-Forwarded-For hop
#   none        trust nothing (correct ONLY for a directly-bound origin)
#
# The origin must be reachable ONLY through that proxy, and the proxy must clear
# the other forwarding headers (the shipped nginx config does). Leaving this
# unset in production is a startup error, because every caller would collapse
# into one shared rate-limit bucket and one user could lock out everyone.
TRUSTED_PROXY="none"

# Behind a reverse proxy / tunnel (nginx, Cloudflare) set this so Auth.js trusts
# the forwarded host. Also baked into auth.ts (trustHost:true); harmless to set.
AUTH_TRUST_HOST="true"
# Canonical origin where auth happens. REQUIRED behind a proxy/tunnel that does
# not preserve the Host header (cloudflared forwards Host: localhost:3000).
# Auth.js builds OAuth callback URLs from this, so without it Google sees the
# wrong redirect_uri and rejects with redirect_uri_mismatch. Unset for local dev.
AUTH_URL="https://app.letsseal.org"

# How long a signed-in session stays valid, in seconds (default 604800 = 7 days).
# Sessions are JWTs, so this bounds how long a stolen token is useful; a signed-out
# or role-changed user is cut off sooner by the session version check in auth.ts.
AUTH_SESSION_MAX_AGE="604800"

# --- OAuth sign-in (all optional, all self-hostable) ---
# Every provider below switches ON automatically the moment BOTH its _ID and
# _SECRET are set, and the "Continue with ..." button appears on the sign-in page;
# leave a pair blank and that provider stays hidden. Email+password always works.
# Registry + how to add more: web/lib/oauth-providers.ts
#
# Redirect / callback URL to register in each provider's console:
#   https://app.letsseal.org/api/auth/callback/<provider-id>
#   (local dev: http://localhost:3000/api/auth/callback/<provider-id>)
# where <provider-id> is: google, github, microsoft-entra-id, facebook, apple,
# gitlab, discord, linkedin.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Microsoft (Entra ID) also needs the tenant/issuer, e.g. "common" for any account:
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
# Others supported out of the box: AUTH_APPLE_ID/SECRET, AUTH_GITLAB_ID/SECRET,
# AUTH_DISCORD_ID/SECRET, AUTH_LINKEDIN_ID/SECRET.

# --- Identity SEALING flow (Sign in with Google/GitHub to seal, not to log in) ---
# The browser identity-signing flow REUSES the OAuth apps above by default, so no
# new vars are needed for Google. Two provider-side steps:
#   * Add the redirect URI  <AUTH_URL>/api/identity/callback  to the OAuth client.
#     Google clients allow multiple redirect URIs, so its login + identity flows
#     share one app. GitHub OAuth Apps allow only ONE callback URL, so GitHub needs
#     a DEDICATED app whose creds go in IDENTITY_GITHUB_ID/SECRET (overrides AUTH_*).
#   * The signing service must trust the SAME client id as the token audience: set
#     OIDC_GOOGLE_CLIENT_ID (in signing-service/.env) equal to AUTH_GOOGLE_ID.
# IDENTITY_GOOGLE_ID=""      # optional: only to use a separate Google app for sealing
# IDENTITY_GOOGLE_SECRET=""
# IDENTITY_GITHUB_ID=""      # recommended: GitHub needs its own app (single callback)
# IDENTITY_GITHUB_SECRET=""

# SMTP for signing invites (Sign / Tier-1 attribution) + completion delivery +
# credential emails. Bring your own SMTP, any provider. If SMTP_HOST + SMTP_FROM
# are unset, ALL email silently no-ops: invites fall back to manual link-sharing
# (weaker attribution; the UI flags it) and completion/credential mails are skipped.
# AWS SES example: SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587,
# SMTP_USER/SMTP_PASS = the SES "SMTP credentials" (NOT your AWS keys), and
# SMTP_FROM must be on your SES-verified domain. Per-org emails send as
# "{Org} via Let's Seal" <SMTP_FROM address> with Reply-To the org's own address.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Let's Seal <no-reply@letsseal.org>"

# Optional SES configuration set. Tags every send so Let's Seal's bounce/complaint
# reputation (and suppression list + pause switch) is tracked separately from other
# projects on the same SES account. Create it in SES, then put its name here.
SES_CONFIGURATION_SET=""

# Blob storage for sealed PDFs / .ots proofs / working copies.
# Leave STORAGE_S3_BUCKET blank to use LOCAL DISK (./storage), the default for
# dev and for self-hosters happy to store on their own disk.
# Set these to use any S3-compatible object store (hosted uses Backblaze B2 for
# cheap storage + free egress; also works for Cloudflare R2 / AWS S3 / MinIO).
# Files are gzip-compressed at rest and deduped by content hash automatically.
STORAGE_S3_BUCKET=""
STORAGE_S3_ENDPOINT=""            # B2: https://s3.<region>.backblazeb2.com   R2: https://<acct>.r2.cloudflarestorage.com
STORAGE_S3_REGION=""              # B2: the bucket's region e.g. us-west-004  R2: auto
STORAGE_S3_ACCESS_KEY_ID=""       # B2: application keyID
STORAGE_S3_SECRET_ACCESS_KEY=""   # B2: applicationKey
STORAGE_S3_PREFIX=""              # optional key prefix within the bucket, e.g. "prod/"

# Optional distributed rate limiting (Upstash Redis REST). With both set, every
# per-IP and per-identifier limit is shared across web instances instead of being
# per-process. Without them the limiters are in-memory, which is correct for a
# single instance. A Redis error degrades to in-memory rather than failing a request.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
