# Signing service configuration. Copy to `.env` (git-ignored); run.sh loads it.
# This process holds the CA/signing keys — bind it to localhost only.

# Shared bearer the web tier must send on every call. Fail-closed: unset => every
# guarded endpoint returns 503. Must match LETSSEAL_SERVICE_TOKEN in web/.env.
LETSSEAL_SERVICE_TOKEN=""

# Passphrase protecting the org signing p12s (and the identity issuer p12). Fail
# closed: unset => /seal* return 503. Must match what ca/setup-ca.sh was run with.
LETSSEAL_P12_PASS=""

# Where the CA output lives (root-ca.crt, intermediate, orgs/, certs/). Default:
# LETSSEAL_CA_DIR="../ca/out"

# Set to "production" to hide the interactive docs / OpenAPI schema.
# LETSSEAL_ENV="production"

# --- OIDC identity sealing (Phase 3) ---
# The service verifies a Google/GitHub/OIDC proof before minting an identity cert.
# A provider is ENABLED only when its client id (the expected token audience) is set.
# For the browser flow, this MUST equal the OAuth client the web tier uses
# (AUTH_GOOGLE_ID in web/.env), so the id_token's audience matches.
# Requires: ca/setup-ca.sh identity-init  (provisions certs/_identity/issuer.p12).
# OIDC_GOOGLE_CLIENT_ID=""
# Microsoft (Entra ID): issuer embeds the tenant — set it explicitly.
# OIDC_MICROSOFT_CLIENT_ID=""
# OIDC_MICROSOFT_ISSUER="https://login.microsoftonline.com/<tenant>/v2.0"
# OIDC_APPLE_CLIENT_ID=""
# Any other standards-OIDC provider (one row): id + audience + issuer.
# OIDC_EXTRA_PROVIDER="okta"
# OIDC_EXTRA_CLIENT_ID=""
# OIDC_EXTRA_ISSUER="https://<your-domain>/oauth2/default"
# GitHub is OAuth (not OIDC) — enable its adapter (verifies via the GitHub API).
# OIDC_GITHUB_ENABLED="1"
